{
  "Comment": "SOW -> scope (agent) -> human approval -> deterministic render of Terraform + CloudFormation -> validation -> delivered.",
  "StartAt": "ExtractText",
  "States": {
    "ExtractText": {
      "Type": "Task", "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${PhaseExtractArn}", "Payload": {"runId.$": "$.runId"}},
      "ResultPath": null,
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "MarkFailed", "ResultPath": "$.error"}],
      "Next": "ExtractScope"
    },
    "ExtractScope": {
      "Type": "Task", "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${PhaseInvokeArn}", "Payload": {"runId.$": "$.runId", "phase": "intake"}},
      "ResultPath": null,
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 15, "MaxAttempts": 1, "BackoffRate": 2}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "MarkFailed", "ResultPath": "$.error"}],
      "Next": "GateA"
    },
    "GateA": {
      "Type": "Task", "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {"FunctionName": "${GateWaitArn}", "Payload": {"runId.$": "$.runId", "gate": "A", "taskToken.$": "$$.Task.Token"}},
      "ResultPath": null, "TimeoutSeconds": 604800,
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "MarkFailed", "ResultPath": "$.error"}],
      "Next": "RenderStacks"
    },
    "RenderStacks": {
      "Type": "Task", "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${PhaseRenderArn}", "Payload": {"runId.$": "$.runId"}},
      "ResultPath": null,
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "MarkFailed", "ResultPath": "$.error"}],
      "Next": "ValidateStacks"
    },
    "ValidateStacks": {
      "Type": "Task", "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${ValidateProject}",
        "EnvironmentVariablesOverride": [{"Name": "RUN_ID", "Type": "PLAINTEXT", "Value.$": "$.runId"}]
      },
      "ResultPath": null,
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "MarkFailed", "ResultPath": "$.error"}],
      "Next": "MarkDelivered"
    },
    "MarkDelivered": {
      "Type": "Task", "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${PhaseStatusArn}", "Payload": {"runId.$": "$.runId", "status": "DELIVERED"}},
      "ResultPath": null,
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "MarkFailed", "ResultPath": "$.error"}],
      "End": true
    },
    "MarkFailed": {
      "Type": "Task", "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${PhaseStatusArn}", "Payload": {"runId.$": "$.runId", "status": "FAILED", "error.$": "$.error"}},
      "ResultPath": null, "Next": "Failed"
    },
    "Failed": {"Type": "Fail", "Error": "RunFailed", "Cause": "See the run's audit log"}
  }
}
