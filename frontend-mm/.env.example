# Sign-in is ON only when both ids are set (they are, in .env.production). Leave them empty for local work without sign-in.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=
# Only for a local test server that speaks Cognito's API; never set in a deployed build.
NEXT_PUBLIC_COGNITO_ENDPOINT=
